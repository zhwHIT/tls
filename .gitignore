# Python/runtime caches
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/

# Local editor and agent state
.claude/
.codex/
.agents/

# Empty extraction staging directories
closed_corpora_staging/

# Runtime sidecars and download caches (data and indexes are versioned)
*.sqlite3-shm
*.sqlite3-wal
chronos_repro/models/**/.cache/

# Local duplicate checkouts and superseded download copies
/chronos_repro_v99_review/
/closed_corpora_download/
/chronos_repro/3.4

# Keep the active embedding runtime, not duplicate/full-precision weights
/chronos_repro/models/**/*.safetensors
/chronos_repro/models/paraphrase-multilingual-MiniLM-L12-v2-onnx-int8-avx2/

# Curated data snapshot: active indexes, extracted events and latest valid runs.
# Previously committed files remain tracked; historical local runs stay on disk.
/chronos_repro/artifacts/*
!/chronos_repro/artifacts/crisis_dense_collection_v3/
!/chronos_repro/artifacts/entities_dense_collection_v3/
!/chronos_repro/artifacts/t17_dense_collection_v3/
